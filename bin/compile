#!/usr/bin/env bash
# usage: bin/compile <build_dir> <cache_dir> <env_dir>

cmnlib="$( readlink -f "$( dirname "${0}" )/../vendor/cmnlib.sh" )"
# shellcheck source=vendor/cmnlib.sh
source "${cmnlib}"


cmn::main::start "${0}" "${1}" "${2}" "${3}"

# -----------------------------------------------------------------------------

# shellcheck source=VERSIONS
source "${buildpack_dir:?}/VERSIONS"
version="${KEYCLOAK_VERSION:-"${KEYCLOAK_DEFAULT_VERSION}"}"

archive="keycloak-${version}.tar.gz"

archive_url="https://github.com/keycloak/keycloak/releases/download/${version}/${archive}"
hash_url="${archive_url}.sha1"

cache_file="${cache_dir:?}/${archive}"
hash_file="${tmp_dir:?}/${archive}.sha1"

keycloak_dir="${build_dir:?}/keycloak"

build_log="${tmp_dir:?}/build.log"

# -----------------------------------------------------------------------------

cmn::step::start "Installing JVM"

# Use buildpack-jvm-common buildpack to setup JVM:
cmn::bp::run "${build_dir:?}" "${cache_dir:?}" "${env_dir:?}" "${tmp_dir:?}" \
	"https://github.com/Scalingo/buildpack-jvm-common"

# -----------------------------------------------------------------------------

cmn::step::start "Installing Keycloak"

# We always check archive validity using a freshly downloaded checksum to
# detect/prevent immutability issues (i.e. cases where upstream replaces the
# archive at the same URL/same version number)
# So let's download the checksum:
cmn::task::start "Downloading checksum"
if ! cmn::file::download "${hash_url}" "${hash_file}"; then
	cmn::main::fail "${?}" <<-EOM
		Unable to download checksum file.
		Aborting.
	EOM
fi
cmn::task::finish

if [[ ! -f "${cache_file}" ]]; then
	# The archive doesn't exist in the cache.

	# Remove any existing cached archive, as they are probably for another
	# version:
	cmn::task::start "Cleaning cache"
	rm --recursive --force "${cache_dir:?}"/keycloak*.tar.gz
	cmn::task::finish

	# Download appropriate version:
	cmn::task::start "Downloading archive"
	if ! cmn::file::download "${archive_url}" "${cache_file}"; then
		cmn::main::fail "${?}" <<-EOM
			Unable to download Keycloak archive.
			Aborting.
		EOM
	fi
	cmn::task::finish
else
	# The archive is in cache.

	cmn::output::info "Found matching file in cache."
fi

# From this point, we have an archive in cache.

# We always check the archive validity to prevent cache corruption and other
# issues.
cmn::task::start "Checking archive validity"
if ! cmn::file::validate_checksum "${cache_file}" "${hash_file}"; then
	# File in cache does not seem valid,
	# remove it so a future run can be successful
	rm --force "${cache_file}"

	cmn::main::fail 2 <<-EOM
		The checksum for the archive file in the cache doesn't match what's
		expected.

		Here are the most common causes:

		- The archive file in the cache is corrupt. This can unfortunately
		  happen, but has no strong consequences. Triggering a new deployment
		  should fix the issue.

		- A networking issue occurred, causing the downloaded checksum file to
		  be incomplete or corrupt. Triggering a new deployment should force
		  the platform to download the archive and the checksum again, and the
		  deployment should pass.

		- Upstream replaced the archive and its checksum, resulting in the
		  same version number having a different checksum. This could mean a
		  malicious threat tampered the source archive and its checksum.
		  Please check upstream for a potential explanation and make sure it's
		  still trustable.

		In all cases, the cached archive has been removed to force a new
		download during the next deployment attempt.

		Aborting.
	EOM
fi
cmn::task::finish

# From this point we have a valid file in cache.

cmn::task::start "Extracting"
mkdir --parents "${keycloak_dir}"
tar --extract --file="${cache_file}" --directory="${keycloak_dir}" \
	--strip-components=1
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::step::start "Configuring"

cmn::task::start "Setting up clustering"
cp "${buildpack_dir:?}/vendor/cache-ispn.xml" "${keycloak_dir}/conf/"
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::step::start "Building environment"

mkdir --parents "${build_dir:?}/.profile.d"

cmn::task::start "Setting up environment"
cp "${buildpack_dir:?}/vendor/profile.d/050-keycloak.sh" \
	"${build_dir:?}/.profile.d/"
cmn::task::finish

cmn::task::start "Loading environment"
source "${build_dir:?}/.profile.d/050-keycloak.sh"
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::step::start "Building optimized Keycloak image"

cmn::task::start "Compiling"
if ! "${keycloak_dir}/bin/kc.sh" build > "${build_log}" 2>&1; then
	err="${?}"
	cmn::task::fail
	cmn::output::err < "${build_log}"
	cmn::main::fail "${err}" <<-EOM
		Unable to build optimized Keycloak image.
		Aborting.
	EOM
fi
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::main::finish
